#main {
    height: 1fr;
}

LibraryTree, QueueView, NowPlaying {
    border: round $panel-lighten-2;
    border-title-color: $text-muted;
    background: $surface;
}

LibraryTree:focus, QueueView:focus {
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

LibraryTree {
    width: 2fr;
    padding: 0 1;
}

QueueView {
    width: 3fr;
}

NowPlaying {
    height: 12;
    padding: 0 1;
    border: round $accent;
    border-title-color: $accent;
    border-title-style: bold;
}

#np-info {
    width: 38;
    padding-top: 1;
}

#np-title, #np-details {
    margin-bottom: 1;
}

#np-spectrum {
    width: 1fr;
}

#np-progress {
    margin: 0 3;
}
